# AI DisasterTwin Rescue — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NOTE: OpenAI billing is separate from ChatGPT subscriptions.
# The app runs fully in demo mode without any API keys.

# Application
APP_ENV=development
DEMO_MODE=true

# Database (SQLite for local dev; change to postgresql://... for production)
DATABASE_URL=sqlite:///./disastertwin.db

# OpenAI (optional — app uses deterministic rules if not set)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Open-Meteo (free, no key needed)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# NASA FIRMS (optional fire/hotspot data)
# Register at https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=
